# The team's one address (deploy/web.Dockerfile). Plain HTTP on 8080 inside the container: compose
# publishes it on the host's loopback only, and the private door in front of it (tailscale serve) adds
# HTTPS. The pages and the API share this address, so the browser needs no CORS to call it.
{
	admin off
	auto_https off
	persist_config off
}

# One browser app: its built files, and index.html for any other path (the app routes in the browser).
(page) {
	# Built files carry a hash in their name and never change: keep them. A missing one is a 404, not
	# the page, so a browser holding an old page fails clearly.
	@asset path /assets/*
	handle @asset {
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# The page itself is checked again on every visit, so an update shows at once.
	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}

:8080 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}

	# The API. It checks the clinician's token itself; this only passes the request on. The ingest
	# door (/sim/*, which includes the lab worker's /sim/lab/*) is for the ward runner and the lab
	# worker, which reach the API inside compose and never through here: from this address it does
	# not exist.
	handle_path /api/* {
		@ingest path /sim /sim/*
		respond @ingest 404
		reverse_proxy api:8000
	}

	# The full ward simulator: the page that draws the ward the runner is running. Not under /ward:
	# that is a page of the dashboard.
	redir /simulator /simulator/
	handle_path /simulator/* {
		root * /srv/simulator
		import page
	}

	# The dashboard: one page that routes in the browser, so an unknown path gets index.html.
	handle {
		root * /srv/dashboard
		import page
	}
}
